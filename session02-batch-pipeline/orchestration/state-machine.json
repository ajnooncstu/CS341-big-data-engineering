{
  "Comment": "CS341 Session 02 teaching scaffold",
  "StartAt": "CheckBatch",
  "States": {
    "CheckBatch": {
      "Type": "Task",
      "Resource": "<CHECK_BATCH_LAMBDA_ARN>",
      "Next": "AlreadyProcessed?"
    },
    "AlreadyProcessed?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "ALREADY_PROCESSED",
          "Next": "StopAlreadyProcessed"
        }
      ],
      "Default": "Validate"
    },
    "StopAlreadyProcessed": {
      "Type": "Succeed"
    },
    "Validate": {
      "Type": "Task",
      "Resource": "<VALIDATE_LAMBDA_ARN>",
      "Next": "Valid?"
    },
    "Valid?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.validation_status",
          "StringEquals": "PASS",
          "Next": "Transform"
        }
      ],
      "Default": "Quarantine"
    },
    "Transform": {
      "Type": "Task",
      "Resource": "<TRANSFORM_LAMBDA_ARN>",
      "Next": "Verify"
    },
    "Verify": {
      "Type": "Task",
      "Resource": "<VERIFY_LAMBDA_ARN>",
      "End": true
    },
    "Quarantine": {
      "Type": "Task",
      "Resource": "<QUARANTINE_LAMBDA_ARN>",
      "End": true
    }
  }
}